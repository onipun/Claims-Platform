{
  "name": "claims-platform-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:api:check": "node scripts/gen-api.mjs --check"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@fontsource/inter": "5.3.0",
    "autoprefixer": "10.6.2",
    "lucide-angular": "1.0.0",
    "postcss": "8.5.32",
    "rxjs": "7.8.0",
    "tailwindcss": "3.4.19",
    "tslib": "2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "jsdom": "30.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "lucide-angular": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
